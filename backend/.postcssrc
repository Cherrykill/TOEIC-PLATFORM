{
  "plugins": {
    "postcss-sorting": {
      "order": [
        "custom-properties",
        "dollar-variables",
        "declarations",
        "rules",
        "at-rules"
      ],
      "properties-order": [
        "display",
        "position",
        "top",
        "right",
        "bottom",
        "left",
        "z-index",

        "box-sizing",
        "width",
        "height",
        "margin",
        "padding",

        "background",
        "border",
        "border-radius",

        "color",
        "font",
        "font-size",
        "font-weight",
        "line-height",
        "text-align",

        "opacity",
        "transform",
        "transition"
      ],
      "unspecified-properties-position": "bottom"
    }
  }
}
